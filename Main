    <!-- Button Options -->
    <button onclick="yesResponse()">Yes</button>
    <button onclick="noResponse(2)">No</button>

    <script>
        function yesResponse() {
            window.location.href = 'Yes.html';  // Redirect to the "Yes" page
        }

        function noResponse(noCount) {
            if (noCount === 2) {
                window.location.href = 'No2.html';  // Redirect to no2.html if second "No"
            } else if (noCount === 3) {
                window.location.href = 'no3.html';  // Redirect to no3.html if third "No"
            } else {
                window.location.href = 'Yes.html';  // After 4 "No"s, go to the "Yes" page
            }
        }
    </script>
